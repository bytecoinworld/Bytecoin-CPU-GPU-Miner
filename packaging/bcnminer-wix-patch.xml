<CPackWiXPatch>
  <CPackWiXFragment Id="#PRODUCT">
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch BCN Miner now" />
    <Property Id="WixShellExecTarget" Value="[#CM_FP_bcnminer.exe]" />
    <CustomAction Id="LaunchBcnMiner" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Execute="immediate" Return="check" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchBcnMiner" Order="1" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
  </CPackWiXFragment>
  <CPackWiXFragment Id="#PRODUCTFEATURE">
    <ComponentRef Id="BcnMinerDesktopShortcut" />
  </CPackWiXFragment>
</CPackWiXPatch>
